/* Lexis Visor themes. Every color variable used below
   comes from the registered themes in themes.py: Foxfire
   Ember (locked 2026-11-10: foxfire orange #ff7a29 +
   amber #e0a83c on warm charcoal black) is the default,
   Kitsune Azure (Master, 2026-11-10) is the second theme.
   The variables are deliberately NOT defined in this
   stylesheet: a stylesheet-local definition shadows the
   active theme's variables (proven by ThemeSwitchTest on
   the PC, 2026-11-13), which would freeze the face on
   one palette. The stylesheet itself never changes. */

Screen {
    background: $bg;
    color: $txt;
}

#hdr {
    height: 1;
    background: $pnl;
    padding: 0 1;
}

#body {
    height: 1fr;
}

#main {
    width: 1fr;
    height: 100%;
}

#bannerbox {
    background: $pnl2;
    border: solid $line;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

#welcome {
    color: $dim;
    height: auto;
}

#chat {
    height: 1fr;
    padding: 0 1;
}

#rail {
    width: 44;
    height: 100%;
    background: $pnl2;
    padding: 0 1;
}

.pnl {
    border: solid $line;
    background: $pnl;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

#ctxbar {
    height: 1;
    margin: 0 0 1 0;
}

#writebar {
    height: 1;
    margin: 0 1;
    display: none;
}

#writebar.on {
    display: block;
}

#status {
    height: 2;
    background: $pnl;
    padding: 0 1;
}

#composerbox {
    border: solid $line2;
    background: $bg;
    padding: 0 1;
    height: auto;
}

#composer {
    height: 4;
    background: $bg;
}

#hints {
    height: 1;
    color: $faint;
}

.msg {
    margin-bottom: 1;
    height: auto;
}

.card {
    border-left: thick $faint;
    background: $pnl;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

.card.ok {
    border-left: thick $green;
}

.card.run {
    border-left: thick $ember;
}

.card.wait {
    border-left: thick $amber;
}

#activity {
    height: 1;
    display: none;
    padding: 0 1;
    color: $dim;
}

#activity.on {
    display: block;
}

#livecode {
    border: solid $line;
    background: #0a0806;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
    display: none;
}

#livecode.on {
    display: block;
}

#typing {
    height: 3;
    display: none;
    color: $amber;
}

#typing.on {
    display: block;
}

.modalbox {
    background: $pnl;
    border: solid $line2;
    padding: 1 2;
    width: 88;
    height: auto;
    max-height: 92%;
}

.modalbox Horizontal {
    height: auto;
}

.diffscroll {
    height: 1fr;
    min-height: 3;
}

ApprovalScreen, PaletteScreen, PickScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.55);
}

.modalbox Button {
    margin-right: 1;
}

OptionList {
    background: $pnl;
    border: solid $line;
    height: auto;
    max-height: 16;
}

ProgressBar > .bar--bar {
    background: $ember;
}

ProgressBar > .bar--complete {
    background: $amber;
}

BootScreen {
    background: #0c0a08;
    align: center middle;
}

BootScreen Vertical {
    width: auto;
    height: auto;
}

#boot-stages {
    margin-top: 1;
}

#boot-bar {
    width: 64;
    margin-top: 1;
}

.sep {
    height: 1;
    margin-top: 1;
}

.attach {
    height: 1;
    margin-left: 2;
}

#slashmenu {
    display: none;
    border: solid $line2;
    background: $pnl;
    padding: 0 1;
    margin-top: 1;
    height: auto;
    max-height: 12;
}

#slashmenu.on {
    display: block;
}

#status {
    border-top: solid $line2;
    padding: 0 1;
}
